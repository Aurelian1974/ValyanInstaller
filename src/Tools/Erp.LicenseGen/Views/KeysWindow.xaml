<Window x:Class="Erp.LicenseGen.Views.KeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chei de semnare"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Chei de semnare" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,18"
                       Text="Cheia privată se păstrează numai pe acest calculator, criptată DPAPI, și nu intră niciodată în depozitul de cod. Cheia publică și cheia AES mascată se lipesc în LicenseKeys.cs." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MatchText}" Style="{StaticResource Subtle}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding Snippet, Converter={StaticResource NullToCollapsed}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                           Text="Lipiți textul de mai jos în LicenseKeys.cs, în metoda Materials(), apoi recompilați generatorul, installer-ul și ERP-ul:" />

                <TextBox Grid.Row="1" Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <Button Grid.Row="2" Content="Copiază textul" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Command="{Binding CopySnippetCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0">
            <StackPanel>
                <Border Background="{StaticResource Amber50}" CornerRadius="9" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding WarningText}" Foreground="#6b4b00" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Generează o cheie nouă" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateKeyCommand}" Margin="0,0,10,0" />
                        <Button Content="Copie de siguranță…" Click="OnBackupClick" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Închide" Click="OnCloseClick" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
