<Window x:Class="Erp.LicenseGen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErpLicenseGen · Generator de licențe (intern)"
        Width="1100" Height="780" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,24,28,16">
            <StackPanel>
                <TextBlock Text="Licență nouă" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,22"
                           Text="Fișierul .lic se criptează (AES-256-GCM) și se semnează (ECDSA P-256) cu cheia din acest calculator. Nu se livrează niciodată aplicația aceasta." />

                <!-- Denumire client și număr licență -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Denumire client *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Număr licență" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding LicenseNumberText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" IsReadOnly="True" />
                    </StackPanel>
                </Grid>

                <!-- CUI-uri și rezultatul validării -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CUI-uri *" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,-4,0,6"
                                   Text="Câte unul pe rând, sau separate prin virgulă, spațiu ori „:”; cu sau fără RO." />
                        <TextBox Height="132" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}"
                                 Text="{Binding FiscalCodesText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Rezultatul validării" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding FiscalCodesSummary}" Foreground="{StaticResource Green}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Subtle}" Margin="0,4,0,10" />
                            <TextBlock Style="{StaticResource Subtle}"
                                       Text="Se scrie în licență, doar cifre, separate prin „:”" />
                            <TextBlock Text="{Binding NormalizedFiscalCodes}" Style="{StaticResource Mono}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Valabilitate și tip -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Width="200">
                        <TextBlock Text="Valabilă până la" Style="{StaticResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding ValidUntil}" Height="34"
                                    IsEnabled="{Binding IsUnlimited, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <CheckBox Content="Nelimitat" IsChecked="{Binding IsUnlimited}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="24,0,0,10">
                        <TextBlock Text="Tip" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- Module -->
                <TextBlock Text="Module" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="240" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding IsEnabled}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Limite -->
                <TextBlock Text="Limite" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Utilizatori" Style="{StaticResource Subtle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Users, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Angajați salarizare" Style="{StaticResource Subtle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PayrollEmployees, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Case POS" Style="{StaticResource Subtle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PosTerminals, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Erori și avertismente -->
                <Border Background="{StaticResource Red50}" CornerRadius="9" Padding="12" Margin="0,18,0,0"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="#8a2424" />
                </Border>

                <Border Background="{StaticResource Amber50}" CornerRadius="9" Padding="12" Margin="0,12,0,0"
                        Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding WarningText}" Foreground="#6b4b00" />
                </Border>

                <Border Background="{StaticResource Green50}" CornerRadius="9" Padding="12" Margin="0,12,0,0"
                        Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="#11603b" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bara de jos -->
        <Border Grid.Row="1" Background="#fafbfc" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Chei" Click="OnKeysClick" Margin="0,0,10,0" />
                    <Button Content="Deschide o licență" Command="{Binding OpenLicenseCommand}" Margin="0,0,10,0" />
                    <Button Content="Registrul licențelor" Command="{Binding ShowRegistryCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding KeyStatusText}" Style="{StaticResource Subtle}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0" />

                <Button Grid.Column="2" Content="Generează licența…" Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" />
            </Grid>
        </Border>
    </Grid>
</Window>
