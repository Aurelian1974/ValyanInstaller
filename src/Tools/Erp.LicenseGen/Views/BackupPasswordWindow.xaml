<Window x:Class="Erp.LicenseGen.Views.BackupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parola copiei de siguranță"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        FontFamily="{StaticResource UiFont}">

    <StackPanel Margin="24">
        <TextBlock Text="Parola copiei de siguranță" Style="{StaticResource H1}" FontSize="18" />
        <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,16"
                   Text="Copia conține cheia privată, criptată cu această parolă. Păstrați-o offline. Parola are cel puțin 12 caractere și nu se poate recupera." />

        <TextBlock Text="Parolă" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="FirstBox" Height="32" PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="Repetați parola" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
        <PasswordBox x:Name="SecondBox" Height="32" PasswordChanged="OnPasswordChanged" />

        <TextBlock x:Name="MessageText" Foreground="{StaticResource Red}" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Renunță" Click="OnCancelClick" Margin="0,0,10,0" />
            <Button x:Name="OkButton" Content="Salvează copia" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
